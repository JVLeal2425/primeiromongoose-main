<%- include('../cabecalho.ejs')%>
    <main class="container">
        <h3>Editar Gênero</h3>
        <div class="form-container">
            <form id="form-genero" method="post" autocomplete="off">
                <div class="form-group">
                    <label for="id">ID do Gênero</label>
                    <input id="id" value="<%=genero.id%>" name="id" type="text" placeholder="idzao" required>
                </div>
                <div class="form-group">
                    <label for="nome">Nome do Gênero</label>
                    <input id="nome" value="<%=genero.nome%>" name="nome" type="text" placeholder="Rock" required>
                </div>
                <div class="field-help">Os campos com * são obrigatórios.</div>
                <a type="button" class="btn btn-secondary" id="btn-cancelar" href="/genero">Cancelar</a>
                <button type="submit" class="btn btn-success">Editar Gênero</button>
            </form>
        </div>
    </main>

    <%- include('../rodape.ejs')%>