<%- include('../cabecalho.ejs')%>
    <main class="container">
        <a href="artista/lsta" class="back-link">← Voltar para lista</a>

        <div class="form-container">
            <h2>Cadastrar Novo Artista</h2>

            <form method="post">
                <div class="form-group">
                    <label for="anome">Nome do Artista *</label>
                    <input type="text" id="anome" name="anome">
                </div>

                <div class="form-group">
                    <label for="pais">País *</label>
                    <input type="text" id="pais" name="pais">
                </div>

                <div class="form-group">
                    <label for="ai">Ano de início da Carreira *</label>
                    <input type="number" id="ai" name="ai">
                </div>


                <div class="form-buttons">
                    <button type="submit" class="btn btn-success">Cadastrar</button>
                    <a href="artista.html" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </main>
    <%- include('../rodape.ejs')%>