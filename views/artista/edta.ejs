<%- include('../cabecalho.ejs')%>
    <main class="container">
        <h3>Editar Artista</h3>
        <div class="form-container">
            <form id="form-genero" method="post" autocomplete="off">
                <div class="form-group">
                    <label for="id">ID do Artista</label>
                    <input id="id" value="<%=artista.id%>" name="id" type="text" placeholder="idzao" required>
                </div>
                <div class="form-group">
                    <label for="nome">Nome do Artista</label>
                    <input id="nome" value="<%=artista.nome%>" name="nome" type="text" placeholder="Phoebe Bridgers"
                        required>
                </div>
                <div class="form-group">
                    <label for="pais">País do Artista</label>
                    <input id="pais" value="<%=artista.pais%>" name="pais" type="text" placeholder="EUA" required>
                </div>
                <div class="form-group">
                    <label for="anoinicio">Ano de Início da Carreira</label>
                    <input id="anoinicio" value="<%=artista.anoinicio%>" name="anoinicio" type="number"
                        placeholder="2017" required>
                </div>
                <div class="field-help">Os campos com * são obrigatórios.</div>
                <a type="button" class="btn btn-secondary" id="btn-cancelar" href="/artista">Cancelar</a>
                <button type="submit" class="btn btn-success">Editar Artista</button>
            </form>
        </div>
    </main>

    <%- include('../rodape.ejs')%>