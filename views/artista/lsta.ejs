<%- include('../cabecalho.ejs')%>

    <main class="container">
        <div class="page-header">
            <h2>Lista de Artistas</h2>
            <a href="/artista/adda" class="btn btn-success">+ Novo Artista</a>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>País</th>
                        <th>Ano Início</th>
                        <th>Ações</th>
                        <th>Ações+</th>
                        <th>Edições+</th>
                    </tr>
                </thead>
                <tbody>
                    <%artista.forEach(artista=>{%>
                        <tr>
                            <td>
                                <%=artista.nome%>
                            </td>
                            <td>
                                <%=artista.pais%>
                            </td>
                            <td>
                                <%=artista.anoinicio%>
                            </td>
                            <td><a href="/artista/dd" class="link">Ver Detalhes</a></td>
                            <td><a href="/artista/del/<%=artista.id%>" class="link">Excluir</a></td>
                            <td><a href="/artista/edta/<%=artista.id%>" class="link">Editar</a></td>
                        </tr>
                        <%})%>
                </tbody>
            </table>
        </div>
    </main>

    <%- include('../rodape.ejs')%>